%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**6.1. Architecture Review by ITSS, Business(es), Vendor**"]
    direction TB
    START[/"Input: Approved Implementation Plan"/]
    START --> S1("Vendor Presents Technical Architecture")
    S1 --> S2("ITSS Reviews Infrastructure Requirements")
    S2 --> S3("Business Reviews Functional Requirements")
    S3 --> S4("Assess Integration Points with Existing Systems")
    S4 --> S5("Review Scalability & Performance Requirements")
    S5 --> S6("Evaluate Security Architecture")
    S6 --> S7{"Does architecture meet all requirements?"}
    S7 -->|Yes| S8["Architecture Approved"]
    S7 -->|No| S9["Document Architecture Gaps"]
    S9 --> S10("Vendor Revises Architecture Design")
    S10 --> S11{"Are revisions acceptable?"}
    S11 -->|Yes| S8
    S11 -->|No| S12(["Architecture Review Failed"])
    S8 --> END[/"Output: Final Architecture Design"/]
end

%% Styling
classDef implementationStyle fill:#1E3A5F,stroke:#333,stroke-width:2px,color:#fff
classDef implementationDecision fill:#4A6B9F,stroke:#333,stroke-width:2px,color:#fff
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S5,S6,S8,S9,S10,END implementationStyle
class S7,S11 implementationDecision
class S12 exitStyle

linkStyle default stroke:#333,stroke-width:2px
