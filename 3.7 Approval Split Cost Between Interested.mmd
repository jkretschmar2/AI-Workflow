%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**3.7. Approval (Split cost between those interested)**"]
    direction TB
    START[/"Input: List of Interested Business Units"/]
    START --> S1("Identify All Interested Business Units")
    S1 --> S2("Calculate Total Pilot Cost")
    S2 --> S3("Propose Cost Allocation Formula")
    S3 --> S4("Distribute Cost Breakdown to Each BU")
    S4 --> S5{"Do all BUs agree to cost allocation?"}
    S5 -->|Yes| S6["Document Cost Sharing Agreement"]
    S5 -->|No| S7("Negotiate Alternative Cost Split")
    S7 --> S8{"Can consensus be reached?"}
    S8 -->|Yes| S6
    S8 -->|No| S9["Remove Non-Participating BUs"]
    S9 --> S10{"Are there still 2+ BUs?"}
    S10 -->|Yes| S3
    S10 -->|No| S11(["Multi-Business Pilot Cancelled"])
    S6 --> END[/"Output: Cost Allocation Approved"/]
end

%% Styling
classDef demoStyle fill:#00A0E9,stroke:#333,stroke-width:2px,color:#fff
classDef demoDecision fill:#66C3F4,stroke:#333,stroke-width:2px,color:#000
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S6,S7,S9,END demoStyle
class S5,S8,S10 demoDecision
class S11 exitStyle

linkStyle default stroke:#333,stroke-width:2px
