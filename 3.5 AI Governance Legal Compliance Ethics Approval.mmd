%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**3.5. AI Governance Legal/Compliance/Ethics Approval**"]
    direction TB
    START[/"Input: AI Application Details"/]
    START --> S1("Legal Review - Terms & Contracts")
    S1 --> S2("Compliance Review - Regulatory Requirements")
    S2 --> S3("Ethics Review - Bias & Fairness")
    S3 --> S4("Data Privacy Assessment - GDPR, DFARS, etc.")
    S4 --> S5("Intellectual Property Review")
    S5 --> S6{"Are all governance requirements satisfied?"}
    S6 -->|Yes| S7["Governance Approval Granted"]
    S6 -->|No| S8["Document Compliance Gaps"]
    S8 --> S9("Develop Mitigation Plan")
    S9 --> S10{"Can gaps be adequately mitigated?"}
    S10 -->|Yes| S7
    S10 -->|No| S11(["Governance Approval Denied"])
    S7 --> END[/"Output: Governance Clearance"/]
end

%% Styling
classDef demoStyle fill:#00A0E9,stroke:#333,stroke-width:2px,color:#fff
classDef demoDecision fill:#66C3F4,stroke:#333,stroke-width:2px,color:#000
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S5,S7,S8,S9,END demoStyle
class S6,S10 demoDecision
class S11 exitStyle

linkStyle default stroke:#333,stroke-width:2px
