%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**5.2. AI Governance Committee Review**"]
    direction TB
    START[/"Input: AI Board Recommendation"/]
    START --> S1("Review Legal & Compliance Requirements")
    S1 --> S2("Assess Ethical Implications")
    S2 --> S3("Evaluate Risk Management Plan")
    S3 --> S4("Review Data Governance Policies")
    S4 --> S5("Assess Organizational Readiness")
    S5 --> S6{"Does Governance Committee approve?"}
    S6 -->|Yes| S7["Governance Approval Granted"]
    S6 -->|No| S8["Document Governance Concerns"]
    S8 --> S9("Request Additional Mitigations")
    S9 --> S10{"Can concerns be addressed?"}
    S10 -->|Yes| S7
    S10 -->|No| S11(["Governance Approval Denied"])
    S7 --> END[/"Output: Governance Decision"/]
end

%% Styling
classDef formalStyle fill:#945491,stroke:#333,stroke-width:2px,color:#fff
classDef formalDecision fill:#B57FB1,stroke:#333,stroke-width:2px,color:#fff
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S5,S7,S8,S9,END formalStyle
class S6,S10 formalDecision
class S11 exitStyle

linkStyle default stroke:#333,stroke-width:2px
