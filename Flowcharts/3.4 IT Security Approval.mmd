%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**3.4. IT & Security Approval**"]
    direction TB
    START[/"Input: Application for Pilot"/]
    START --> S1("IT Infrastructure Assessment")
    S1 --> S2("Security Risk Assessment")
    S2 --> S3("Data Classification Review")
    S3 --> S4("Network Security Review")
    S4 --> S5("Authentication & Access Control Review")
    S5 --> S6{"Are all security requirements met?"}
    S6 -->|Yes| S7["IT & Security Approval Granted"]
    S6 -->|No| S8["Document Required Security Controls"]
    S8 --> S9("Vendor Implements Required Controls")
    S9 --> S10{"Controls adequately implemented?"}
    S10 -->|Yes| S7
    S10 -->|No| S11(["IT & Security Approval Denied"])
    S7 --> END[/"Output: IT & Security Clearance"/]
end

%% Styling
classDef demoStyle fill:#00A0E9,stroke:#333,stroke-width:2px,color:#fff
classDef demoDecision fill:#66C3F4,stroke:#333,stroke-width:2px,color:#000
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S5,S7,S8,S9,END demoStyle
class S6,S10 demoDecision
class S11 exitStyle

linkStyle default stroke:#333,stroke-width:2px
