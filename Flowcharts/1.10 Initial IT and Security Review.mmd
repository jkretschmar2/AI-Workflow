%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**1.10. Initial IT and Security Review**"]
    direction TB
    START[/"Input: Application Details"/]
    START --> S1("Review Application Security Requirements")
    S1 --> S2("Check Compliance Requirements")
    S2 --> S3("Assess Data Privacy Implications")
    S3 --> S4("Evaluate IT Infrastructure Impact")
    S4 --> S5{"Does application meet security standards?"}
    S5 -->|Yes| S6["Security Approval Granted"]
    S5 -->|No| S7["Identify Security Gaps"]
    S7 --> S8("Request Additional Information or Mitigations")
    S8 --> S1
    S6 --> END[/"Output: Security Review Complete"/]
end

%% Styling
classDef requestStyle fill:#7B4397,stroke:#333,stroke-width:2px,color:#fff
classDef requestDecision fill:#B584D1,stroke:#333,stroke-width:2px,color:#fff

class START,S1,S2,S3,S4,S6,S7,S8,END requestStyle
class S5 requestDecision

linkStyle default stroke:#333,stroke-width:2px
