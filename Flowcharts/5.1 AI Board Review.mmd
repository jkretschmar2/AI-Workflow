%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**5.1. AI Board Review (Formal Request)**"]
    direction TB
    START[/"Input: Successful Pilot Results"/]
    START --> S1("Review Pilot Success Metrics")
    S1 --> S2("Assess Enterprise-Wide Scalability")
    S2 --> S3("Evaluate Strategic Business Impact")
    S3 --> S4("Review Total Cost of Ownership (TCO)")
    S4 --> S5("Assess Risk & Compliance Posture")
    S5 --> S6{"Does AI Board recommend proceeding?"}
    S6 -->|Yes| S7["AI Board Recommendation: Approve"]
    S6 -->|No| S8(["AI Board Recommendation: Deny"])
    S7 --> END[/"Output: AI Board Decision"/]
end

%% Styling
classDef formalStyle fill:#945491,stroke:#333,stroke-width:2px,color:#fff
classDef formalDecision fill:#B57FB1,stroke:#333,stroke-width:2px,color:#fff
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S5,S7,END formalStyle
class S6 formalDecision
class S8 exitStyle

linkStyle default stroke:#333,stroke-width:2px
