flowchart LR

subgraph INPUTS["**0. Required Inputs**"]
    direction TB
    IN1@{ shape: doc, label: "0.1. Placeholder Input 1" }
    IN2@{ shape: doc, label: "0.2. Placeholder Input 2" }
    IN3@{ shape: doc, label: "0.3. Placeholder Input 3" }
    IN4@{ shape: doc, label: "0.4. Placeholder Input 4" }
    IN5@{ shape: doc, label: "0.5. Placeholder Input 5" }
    IN1 ~~~ IN2 ~~~ IN3 ~~~ IN4 ~~~ IN5
end

subgraph REQUEST["**1.0. Request Phase**"]
    direction TB
    INM1("Email/Web Portal")
    INM2("ServiceNow Ticket")
    INM1 --> A0
    INM2 --> A0
    A0[/"1.1. Request Submitted"/]
    A0 --> A0b{"1.2. What type of request?"}
    A0b -->|Product| A1{"1.3. Is there an existing approved application for this function?"}
    %% Link #
    A0b -->|Function| A2{"1.4. Is this the existing approved application?"}
    A1 -->|No| B0a("1.5. Select an applicable market leader")
    B0a --> B1[["1.10. Initial IT and Security Review"]]
    A1 -->|Yes| A3["1.6. License Allocation or Procurement"]
    A3 --> A3a[["1.7. User submit software request 🔗"]]
    A2 -->|Yes| A3
    A2 -->|No| B0b{"1.8. Is the application on the denied software list?"}
    B0b -->|Yes| B5(["1.9. Denied - on denied list"])
    B0b -->|No| B1
    B1 --> B2{"1.11. Does the application pass initial Security and Compliance checks?"}
    B2 -->|No| B2n(["1.13. Notify Requestor - Security Check Failed"])
    B2 -->|Yes| B3@{ shape: delay, label: "1.12. Interest Phase" }
end

subgraph INTEREST["**2.0. Interest Phase**"]
    direction TB
    C0[["2.1. AI Board Review"]]
    C0 --> C1{"2.2. Is there interest from more than one business?"}
    C1 -->|No| C2{"2.3. Does the AI Board approve the effort for a single business?"}
    C2 -->|Yes| C5@{ shape: delay, label: "2.4. Demo Phase" }
    C2 -->|No| C2n(["2.5. Notify Requestor - Single Business Not Approved"])
end

subgraph DEMO["**3.0. Demo Phase**"]
    direction TB
    D0@{ shape: rounded, label: "3.1. Notification to AI Governance" }
    D0 --> D1("3.2. Requester schedules demo with Vendor, IT, Security, AI Board, AI Committee")
    D1 --> D2{"3.6. Interest to move into Pilot phase?"}
    D2 -->|Yes| D2a[["3.3. Pilot Cost Approval by Requestor"]]
    D2 -->|Yes| D2b[["3.4. IT & Security Approval"]]
    D2 -->|Yes| D2c[["3.5. AI Governance Legal/Compliance/Ethics Approval"]]
    D2 -->|Yes| D2d[["3.7. Approval (Split cost between those interested)"]]
    D2 -->|No| D2n(["3.13. Notify Requestor - No Interest for Pilot"])
    D2a --> D2a1{"3.8. Is Cost Approved?"}
    D2b --> D2b1{"3.9. Is IT and Security Approved?"}
    D2c --> D2c1{"3.10. Is Governance Approved?"}
    D2d --> D2d1{"3.11. Is Cost Allocation Approved?"}
    D2a1 -->|No| D2n
    D2b1 -->|No| D2n
    D2c1 -->|No| D2n
    D2d1 -->|No| D2n
    D2b1 -->|Yes| D3@{ shape: delay, label: "3.12. Pilot Phase" }
    D2c1 -->|Yes| D3@{ shape: delay, label: "3.12. Pilot Phase" }
    D2d1 -->|Yes| D3@{ shape: delay, label: "3.12. Pilot Phase" }
end

subgraph PILOT["**4.0. Pilot Phase**"]
    direction TB
    E4("4.1. Define Success Criteria for Pilot")
    E4 --> E5("4.2. Pilot Process with Vendor")
    E5 --> E6{"4.3. Did the Pilot deliver on our Success Criteria?"}
    E6 -->|Yes| E6a@{ shape: delay, label: "4.4. Formal Request Phase" }
    E6 -->|No| E6b(["4.5. Notify Requestor - Pilot Failed"])
end

subgraph FORMAL["**5.0. Formal Request**"]
    direction TB
    F0[["5.1. AI Board Review"]]
    F0 --> F0b[["5.2. AI Governance Committee Review"]]
    F0b --> F3{"5.3. Is there interest from more than one business?"}
    F3 -->|Yes| F1("5.5. Develop Business Case")
    F3 -->|No| F3a{"5.4. Is Single Business Approved?"}
    F3a -->|No| F3an(["5.9. Notify Requestor - Single Business Not Approved"])
    F3a -->|Yes| F6A("5.8. Notify AI Governance Committee - Implementation Approved")
    F6A --> F6@{ shape: delay, label: "5.11. Implementation Phase" }
    F1 --> F2[["5.6. Teledyne Senior Leadership Review"]]
    F2 --> F5{"5.7. Is Enterprise-Wide Deployment Approved?"}
    F5 -->|No| F5n(["5.10. Notify Requestor - Enterprise Deployment Not Approved"])
    F5 -->|Yes| F6A
end

subgraph IMPLEMENTATION["**6.0. Implementation**"]
    direction TB
    G1[["6.1. Architecture Review by ITSS, Business(es), Vendor"]]
    G1 --> G2("6.2. Hardware/Software/Services Procurement")
    G2 --> G3("6.3. Implementation and Testing")
    G3 --> G4{"6.4. Is User Acceptance Testing Successful?"}
    G4 -->|Yes| G6[["6.5. Production Deployment"]]

    G4 -->|No| G3
    G6 --> G7@{ shape: delay, label: "6.6. Evaluation Phase" }
end

subgraph EVALUATION["**7.0. Continuous Evaluation**"]
    direction TB
    H1("7.1. Periodic Review of Success Criteria")
    H1 --> H2{"7.2. Is the product still meeting defined Success Criteria?"}
    H2 -->|No| H3{"7.3. Is the function of the product still needed?"}
    H2 -->|Yes| H2a("7.5. Schedule Next Period Review")
    H3 -->|Yes| H1
    H3 -->|No| H4(["7.4. Decommission Service"])
end

subgraph LEGEND["**Legend: Shape Types**"]
    direction TB
    L1@{ shape: doc, label: "Document" }
    L2[/"Input/Start"/]
    L3("Process")
    L4["Result/Data"]
    L5[["Subprocess"]]
    L6{"Decision"}
    L7(["Exit/Notification"])
    L8@{ shape: delay, label: "Phase Transition" }
    L9@{ shape: rounded, label: "Event" }
    %% L1 ~~~ L2 ~~~ L3 ~~~ L4 ~~~ L5 ~~~ L6 ~~~ L7 ~~~ L8 ~~~ L9
end

