%%{init: {'flowchart': {'htmlLabels': false, 'wrap': false}, 'theme': 'base'}}%%
flowchart TD

subgraph SUBPROCESS["**3.3. Pilot Cost Approval by Requestor**"]
    direction TB
    START[/"Input: Vendor Pilot Proposal"/]
    START --> S1("Vendor Provides Pilot Cost Estimate")
    S1 --> S2("Review Cost Breakdown")
    S2 --> S3("Assess Budget Availability")
    S3 --> S4("Review Expected ROI for Pilot")
    S4 --> S5{"Is cost within acceptable range?"}
    S5 -->|Yes| S6["Requestor Approves Pilot Budget"]
    S5 -->|No| S7("Negotiate with Vendor or Adjust Pilot Scope")
    S7 --> S8{"Can agreement be reached?"}
    S8 -->|Yes| S6
    S8 -->|No| S9(["Cost Approval Denied"])
    S6 --> END[/"Output: Pilot Budget Approved"/]
end

%% Styling
classDef demoStyle fill:#00A0E9,stroke:#333,stroke-width:2px,color:#fff
classDef demoDecision fill:#66C3F4,stroke:#333,stroke-width:2px,color:#000
classDef exitStyle fill:#FF7F7F,stroke:#333,stroke-width:2px,color:#000

class START,S1,S2,S3,S4,S6,S7,END demoStyle
class S5,S8 demoDecision
class S9 exitStyle

linkStyle default stroke:#333,stroke-width:2px
